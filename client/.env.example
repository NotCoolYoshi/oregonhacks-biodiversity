# Copy to .env only if the server is not on the default http://localhost:5001
VITE_API_URL=http://localhost:5001

# Clerk dashboard -> API Keys -> Publishable key. Required — without it
# ClerkProvider is skipped (see src/main.jsx) and sign-in/sign-up are
# disabled, which means POST /api/catches and POST /api/users will 401/503
# on every request.
VITE_CLERK_PUBLISHABLE_KEY=
