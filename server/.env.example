# Copy to .env and fill in. Never commit .env.

# https://my.plantnet.org/ -> free tier
PLANTNET_API_KEY=

# 5001 rather than 5000: on macOS, AirPlay Receiver holds port 5000 and will
# answer requests with a 403 instead of letting this server bind it.
# (System Settings > General > AirDrop & Handoff > AirPlay Receiver)
PORT=5001

# Comma-separated list of origins allowed by CORS. Defaults to Vite's dev server.
CLIENT_ORIGIN=http://localhost:5173

# Supabase dashboard -> Project Settings -> API
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security — server-side only,
# never expose it to the client or prefix it with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
